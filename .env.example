GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.7-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-2.5-flash
# Полная цепочка фолбеков (через запятую, по приоритету). Если не задано,
# используется GEMINI_CHAT_MODEL, GEMINI_CHAT_FALLBACK_MODEL + встроенные резервные модели.
GEMINI_MODEL_CHAIN=gemini-3.7-flash,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SERVICE_BOT_TOKEN=
# Необязательный секрет для проверки, что вебхук действительно шлёт Telegram.
# Если задан — передаётся как secret_token при регистрации вебхука и сверяется
# с заголовком X-Telegram-Bot-Api-Secret-Token на входящих запросах.
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_TELEGRAM_USERNAME=
