# --- Qwen (Alibaba Cloud DashScope, OpenAI-совместимый режим) ---
# Полностью заменяет прежние GEMINI_* переменные.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_CHAT_FALLBACK_MODEL=qwen-turbo
QWEN_MODEL_CHAIN=qwen-plus,qwen-turbo,qwen-max
QWEN_EMBEDDING_MODEL=text-embedding-v3

NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Сервисный бот авторизации / АДМИН-ПАНЕЛИ (личный кабинет / мини-апп / рассылки).
# НЕ бот-агент клиента.
TELEGRAM_BOT_USERNAME=
TELEGRAM_SERVICE_BOT_TOKEN=

# Telegram ID (числовые, из @userinfobot), которым разрешён доступ к
# админ-панели служебного бота (/admin, /broadcast, /setplan, /stats).
# Через запятую, без пробелов: ADMIN_TELEGRAM_IDS=111111111,222222222
ADMIN_TELEGRAM_IDS=

# Секрет для проверки, что вебхук действительно шлёт Telegram.
TELEGRAM_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_TELEGRAM_USERNAME=

# URL Python-сервиса (bot.py/main.py) с RAG-логикой ботов-агентов пользователей.
PYTHON_SERVICE_URL=
