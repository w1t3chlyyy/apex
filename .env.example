GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.7-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_MODEL_CHAIN=gemini-3.7-flash,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Сервисный бот авторизации (личный кабинет / мини-апп). НЕ бот-агент клиента.
TELEGRAM_BOT_USERNAME=
TELEGRAM_SERVICE_BOT_TOKEN=

# Секрет для проверки, что вебхук действительно шлёт Telegram (общий для
# сервисного бота и ботов-агентов пользователей).
TELEGRAM_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_TELEGRAM_USERNAME=

# НОВОЕ: URL Python-сервиса (bot.py) с RAG-логикой ботов-агентов пользователей.
# Именно на него Next.js регистрирует вебхук, когда пользователь подключает
# своего бота в личном кабинете (/dashboard/telegram).
# Пример: https://your-python-service.up.railway.app
PYTHON_SERVICE_URL=
